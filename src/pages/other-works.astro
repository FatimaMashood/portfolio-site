---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import sharp from 'sharp';
import { sets, type Work } from '../data/elsewhere';

const exhibits = (await getCollection('exhibits')).sort((a, b) => a.data.order - b.data.order);

const src = (file: string) => `/images/elsewhere/${file}`;
const srcset = (file: string) => `${src(file)}-600.webp 600w, ${src(file)}-1200.webp 1200w`;

// One flat grid, in order: each set's first cell carries its heading, later cells keep the
// heading row empty so images in a row stay level.
type Cell = { heading?: { title: string; year?: string }; newRow?: boolean } & ({ exhibit: (typeof exhibits)[number]['data'] } | { work: Work });
// shape of each book = its first page
const ratio = async (work: Work) => {
  const { width, height } = await sharp(`public/images/elsewhere/${work.pages[0].file}-1200.webp`).metadata();
  return `${width} / ${height}`;
};
const cells: Cell[] = [
  ...exhibits.map(({ data }, i) => ({ heading: i === 0 ? { title: 'exhibits' } : undefined, exhibit: data })),
  ...sets.flatMap((set) => set.works.map((work, i) => ({ heading: i === 0 ? set : undefined, newRow: i === 0 && set.newRow, work }))),
];
const ratios = new Map(await Promise.all(cells.filter((c) => 'work' in c).map(async (c) => [(c as { work: Work }).work, await ratio((c as { work: Work }).work)] as const)));

// keep an empty heading line only where the other cell in the same row has a heading
let col = 0;
const rowOf: number[] = [];
let row = 0;
for (const cell of cells) {
  if (cell.newRow && col !== 0) { row++; col = 0; }
  rowOf.push(row);
  if (++col === 2) { row++; col = 0; }
}
const rowHasHeading = new Set(cells.flatMap((c, i) => (c.heading ? [rowOf[i]] : [])));
---
<Base title="Other works | Fatima Mashood" description="Photography, illustration and design by Fatima Mashood.">
  <main id="content">
    <header class="page-intro">
      <h1>Other works</h1>
    </header>
    <div class="other-grid">
      {cells.map((cell, i) => (
        <div class:list={['other-cell', { 'new-row': cell.newRow }]}>
          {cell.heading ? (
            <h2 class="cell-heading">{cell.heading.title} {cell.heading.year && <span class="set-year">{cell.heading.year}</span>}</h2>
          ) : rowHasHeading.has(rowOf[i]) && (
            <p class="cell-heading spacer" aria-hidden="true">&nbsp;</p>
          )}
          {'exhibit' in cell ? (
            <a class="exhibit-card" href={`/other-works/${cell.exhibit.slug}/`}>
              <img src={`${cell.exhibit.cover}-1200.webp`} srcset={`${cell.exhibit.cover}-600.webp 600w, ${cell.exhibit.cover}-1200.webp 1200w`} sizes="(min-width: 760px) 50vw, 100vw" alt={cell.exhibit.cover_alt} loading="lazy" decoding="async" />
              <span class="exhibit-title">{cell.exhibit.title}</span>
              <span class="exhibit-venue">{cell.exhibit.venue}</span>
            </a>
          ) : (
            <figure class="book" data-book>
              <div class="book-pages" style={`aspect-ratio:${ratios.get(cell.work)}${cell.work.fill ? `;background:${cell.work.fill}` : ''}`}>
                {cell.work.pages.map((page, i) => (
                  <img
                    class="book-page"
                    style={`z-index:${cell.work.pages.length - i}`}
                    src={`${src(page.file)}-1200.webp`}
                    srcset={srcset(page.file)}
                    sizes="(min-width: 760px) 50vw, 100vw"
                    alt={page.alt}
                    loading="lazy"
                    decoding="async"
                  />
                ))}
                {cell.work.pages.length > 1 && <button type="button" class="book-zone prev" data-prev aria-label="Previous page"></button>}
                {cell.work.pages.length > 1 && <button type="button" class="book-zone next" data-next aria-label="Next page"></button>}
              </div>
              {cell.work.pages.length > 1 && <p class="book-status" aria-live="polite">1 / {cell.work.pages.length}</p>}
            </figure>
          )}
        </div>
      ))}
    </div>
  </main>
</Base>

<script>
  // Page turn: click the right half for the next page, the left half for the previous one.
  // Earlier pages rotate away around the spine (left edge), revealing the next.
  for (const book of document.querySelectorAll<HTMLElement>('[data-book]')) {
    if (!book.querySelector('[data-next]')) continue; // single page, nothing to turn
    const pages = [...book.querySelectorAll<HTMLElement>('.book-page')];
    const prev = book.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = book.querySelector<HTMLButtonElement>('[data-next]')!;
    const status = book.querySelector<HTMLElement>('.book-status')!;
    let current = 0;
    const show = () => {
      pages.forEach((page, i) => {
        page.classList.toggle('turned', i < current);
        page.classList.toggle('below', i > current);
        page.setAttribute('aria-hidden', String(i !== current));
      });
      status.textContent = `${current + 1} / ${pages.length}`;
      prev.disabled = current === 0;
      next.disabled = current === pages.length - 1;
    };
    const go = (step: number) => {
      current = Math.min(pages.length - 1, Math.max(0, current + step));
      show();
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    show();
  }
</script>
