---
// ponytail: the project's own setup drawing split into layers (cat, toy on a stretching string); moves on hover or focus only
const base = '/images/cat-computer-interaction/';
---

<div class="chase-cover">
  <svg viewBox="270 50 1024 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect x="0" y="0" width="1504" height="762" fill="#f3dff5" />
    <image href={base + 'chase-bg.webp'} x="0" y="0" width="1504" height="762" />
    <g class="chase-string"><rect x="-1.4" y="0" width="2.8" height="1" fill="#111" /></g>
    <g class="chase-fish"><image href={base + 'chase-fish.webp'} x="-9" y="0" width="86" height="118" /></g>
    <image class="chase-cat" href={base + 'chase-cat.webp'} x="800" y="505" width="200" height="160" />
  </svg>
</div>

<style is:global>
.chase-cover{position:absolute;inset:0;background:#f3dff5}
.chase-cover svg{display:block;width:100%;height:100%}
.chase-string{transform-origin:0 0;transform:translate(684px,108px) rotate(-12.90deg) scale(1,219.5)}
.chase-fish{transform:translate(733px,322px)}
@media (hover:hover) and (prefers-reduced-motion:no-preference){
.card:hover .chase-fish,.card:focus-visible .chase-fish{animation:chase-fish 9s linear infinite}
.card:hover .chase-string,.card:focus-visible .chase-string{animation:chase-string 9s linear infinite}
.card:hover .chase-cat,.card:focus-visible .chase-cat{animation:chase-cat 9s linear 0.5s infinite backwards}
}
